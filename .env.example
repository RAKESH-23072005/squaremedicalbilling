# Example environment variables for the server
# Copy to .env and fill values (do NOT commit .env to git)

# SMTP configuration (SMTP provider credentials)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# From and To addresses (optional)
FROM_EMAIL=webmaster@example.com
TO_EMAIL=office@squaremedicalbilling.in

# Server port
PORT=3000

# --- If you prefer EmailJS (no SMTP) ---
# These values are copied from the client-side code and should be set if you want the server
# to forward the message via EmailJS's REST API instead of SMTP.
EMAILJS_SERVICE_ID=service_13d2jbh
EMAILJS_TEMPLATE_ID=template_qlz2ebm
# Use your EmailJS Public Key from Dashboard > Account
EMAILJS_PUBLIC_KEY=your-emailjs-public-key

# Backward compatibility only (optional)
# EMAILJS_USER_ID=your-emailjs-public-key
